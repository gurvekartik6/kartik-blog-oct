# Local development uses http://localhost:4000; production should use the deployed API URL.
VITE_API_URL=https://kartik-blog-oct.onrender.com
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/personal_blog
REDIS_URL=redis://127.0.0.1:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_strong_password

# Email provider: Resend requires a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=Field Notes <hello@kartik-gurve.blog>
# For Gmail, enable 2-Step Verification and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
NEWSLETTER_QUEUE_ENABLED=false

# Media provider credentials; configure before production uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, comma-separated origins
CORS_ORIGINS=http://localhost:5173

hii