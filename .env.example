VITE_API_URL=http://localhost:4000
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/personal_blog
REDIS_URL=redis://127.0.0.1:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_strong_password

# Email provider (leave blank for local development; email jobs will be logged)
RESEND_API_KEY=
EMAIL_FROM=Blog Updates <updates@example.com>

# Media provider credentials; configure before production uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, comma-separated origins
CORS_ORIGINS=http://localhost:5173
